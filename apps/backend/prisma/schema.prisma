datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Tabela do Lote de Promoção (Cabeçalho)
model Promocao {
  id         BigInt   @id @default(autoincrement())
  usuario    String   @db.VarChar(100)
  matricula  Int?                      
  dataInicio DateTime @db.Date @map("data_inicio")
  dataFim    DateTime @db.Date @map("data_fim")       
  qtdLinhas  Int      @default(0) @map("qtd_linhas")
  criadoEm   DateTime @default(now()) @map("criado_em")

  itens PromocaoItem[]

  @@map("promocoes")
}

// Tabela de Itens/Linhas Detalhadas
model PromocaoItem {
  id               BigInt   @id @default(autoincrement())
  promocaoId       BigInt   @map("promocao_id")
  codigoProduto    String   @map("codigo_produto") @db.VarChar(50)
  descricaoProduto String   @map("descricao_produto") @db.VarChar(255)
  valorBase        Decimal  @map("valor_base") @db.Decimal(12, 2)
  valorPromocao    Decimal  @map("valor_promocao") @db.Decimal(12, 2)
  planoPagamento   String   @map("plano_pagamento") @db.VarChar(100)
  pertxfim         Decimal  @db.Decimal(8, 4)
  valorPlano       Decimal  @map("valor_plano") @db.Decimal(12, 2)
  pctNecessaria    Decimal  @map("pct_necessaria") @db.Decimal(12, 6)
  qtdInicio        Decimal  @map("qtd_inicio") @db.Decimal(12, 2)
  qtdFim           Decimal  @map("qtd_fim") @db.Decimal(12, 2)
  criadoEm         DateTime @default(now()) @map("criado_em")

  promocao Promocao @relation(fields: [promocaoId], references: [id], onDelete: Cascade)

  @@index([promocaoId])
  @@map("promocao_itens")
}